# ==========================================================
# CONFIGURACION DEL SISTEMA INTELLIGENCE (ENTREGA FINAL)
# ==========================================================

# 1. Configuracion de Redis (Cola y Checkpointing de LangGraph)
REDIS_URL=redis://localhost:6379
QUEUE_NAME=cola_tareas_intelligence
REDIS_CLUSTER_MODE=false

# 2. Observabilidad (Arize Phoenix / LangSmith)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=sistema-intelligence-produccion
# Opcional para LangSmith:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=tu_langsmith_api_key_aqui
# LANGCHAIN_PROJECT=sistema-intelligence-produccion

# 3. Proveedor de LLM (gemini | openai | anthropic)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.0

# 4. Credenciales de Proveedores de LLM
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# 5. Configuracion del Servidor API
API_HOST=0.0.0.0
API_PORT=8000
